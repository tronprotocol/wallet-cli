  "cards": [
    {
      "dot": "emerald",
      "title": "Dependency direction",
      "items": [
        "bootstrap wires everything",
        "inbound and outbound both point at application",
        "application points at domain only"
      ]
    },
    {
      "dot": "violet",
      "title": "Chain families",
      "items": [
        "families/tron.ts and evm.ts register Spec + family Binding pairs",
        "they supply createGateway and signStrategy",
        "neutral code reads FAMILIES from domain/family"
      ]
    },
    {
      "dot": "amber",
      "title": "Plugins",
      "items": [
        "a protocol feature is a plugin, built outside this repository",
        "bootstrap/plugins loads it from ~/.wallet-cli/plugins and registers its commands",
        "it reaches the core only through plugin-sdk"
      ]
    }
  ]
